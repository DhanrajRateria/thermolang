// A very simple 2x2 Ising model for SPICE generation.
// s1--s2
// |   |
// s4--s3
energy fn ising_2x2(s1: float, s2: float, s3: float, s4: float) -> float {
    // Couplings: prefer anti-ferromagnetic (J > 0)
    let J = 1.0; 
    // Local field: prefer spins to be +1 (h > 0)
    let h = 0.25;

    // Horizontal and vertical couplings
    let coupling_energy = J*s1*s2 + J*s2*s3 + J*s3*s4 + J*s4*s1;
    let field_energy = h*s1 + h*s2 + h*s3 + h*s4;

    // Return the standard Ising Hamiltonian
    return -(coupling_energy + field_energy);
}

fn main() -> void {
    // These schedule parameters are illustrative for the compiler;
    // they will be used to configure the .TRAN and .TEMP directives in SPICE.
    let initial_temp = 100.0;
    let cooling_rate = 0.90;
    let steps = 1000;

    let final_config = thermal_anneal(ising_2x2, initial_temp, cooling_rate, steps);
}