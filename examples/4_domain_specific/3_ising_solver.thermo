// A simple Ising model for 4 spins in a square with a local field.
// The goal is to find the spin configuration that minimizes the energy.
energy fn ising_square(s1: float, s2: float, s3: float, s4: float) -> float {
    // Couplings (prefer anti-ferromagnetic: spins align oppositely)
    let J = 1.0; 
    // Local field (prefer spins to be +1)
    let h = 0.5;

    let coupling_energy = J*s1*s2 + J*s2*s3 + J*s3*s4 + J*s4*s1;
    let field_energy = h*s1 + h*s2 + h*s3 + h*s4;

    // Return the standard Ising Hamiltonian
    return -(coupling_energy + field_energy);
}

fn print(value: float) -> void {}

