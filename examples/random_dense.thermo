    E = E + 0.9 * s16 * s19;
    E = E + -0.66 * s17;
    E = E + 1.25 * s17 * s19;
    E = E + -0.09 * s18;
    E = E + 0.89 * s19;
    // Return NEGATIVE energy because hardware minimizes -E
    return -1.0 * E;
}

fn main() -> void {
    let res = thermal_anneal(dense_model, 10.0, 0.95, 2000);
}
