// Random Dense Ising Model (N=20, Density=0.6)
// Generated for Noise Shaping Benchmark

energy fn dense_model(
    s0: float,
    s1: float,
    s2: float,
    s3: float,
    s4: float,
    s5: float,
    s6: float,
    s7: float,
    s8: float,
    s9: float,
    s10: float,
    s11: float,
    s12: float,
    s13: float,
    s14: float,
    s15: float,
    s16: float,
    s17: float,
    s18: float,
    s19: float
