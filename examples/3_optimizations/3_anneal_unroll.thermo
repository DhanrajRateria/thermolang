// examples/3_optimizations/3_anneal_unroll.thermo
fn run_constant_anneal() -> float {
    // This function is a placeholder for the real energy function.
    // The optimizer does not need its body, only its type.
    energy fn my_energy_func(x: float) -> float { return x; }

    // This call has constant parameters and should be unrolled by the optimizer.
    let result = thermal_anneal(my_energy_func, 1.0, 0.9, 5);
    return result;
}