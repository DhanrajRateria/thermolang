    E = E + 0.107534 * s31 * s35;
    E = E + -0.554330 * s31 * s36;
    E = E + -0.230672 * s31 * s37;
    E = E + 1.895046 * s32 * s33;
    E = E + -0.116980 * s32 * s34;
    E = E + 0.537194 * s32 * s37;
    E = E + -1.944598 * s33 * s35;
    E = E + -1.830954 * s33 * s37;
    E = E + -0.912152 * s33 * s39;
    E = E + 1.018118 * s34 * s35;
    E = E + -1.950943 * s34 * s39;
    E = E + 1.210053 * s35 * s36;
    E = E + 0.834851 * s36 * s38;
    E = E + 0.071999 * s36 * s39;
    E = E + 1.258806 * s37 * s38;
    E = E + -1.048030 * s37 * s39;
    return E;
}

fn main() -> void {
    let res = thermal_anneal(model, 5.0, 0.98, 2000);
}
