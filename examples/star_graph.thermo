    E = E + -1.0 * s0 * s13;  // Center connection
    E = E + 0.5 * s13 * s14; // Leaf frustration
    E = E + -1.0 * s0 * s14;  // Center connection
    E = E + 0.5 * s14 * s15; // Leaf frustration
    E = E + -1.0 * s0 * s15;  // Center connection
    E = E + 0.5 * s15 * s16; // Leaf frustration
    E = E + -1.0 * s0 * s16;  // Center connection
    E = E + 0.5 * s16 * s17; // Leaf frustration
    E = E + -1.0 * s0 * s17;  // Center connection
    E = E + 0.5 * s17 * s18; // Leaf frustration
    E = E + -1.0 * s0 * s18;  // Center connection
    E = E + 0.5 * s18 * s19; // Leaf frustration
    E = E + -1.0 * s0 * s19;  // Center connection
    E = E + 0.5 * s19 * s20; // Leaf frustration
