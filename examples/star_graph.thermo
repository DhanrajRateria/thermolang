    E = E + -1.0 * s0 * s21;  // Center connection
    E = E + 0.5 * s21 * s22; // Leaf frustration
    E = E + -1.0 * s0 * s22;  // Center connection
    E = E + 0.5 * s22 * s23; // Leaf frustration
    E = E + -1.0 * s0 * s23;  // Center connection
    E = E + 0.5 * s23 * s24; // Leaf frustration
    E = E + -1.0 * s0 * s24;  // Center connection
    E = E + 0.5 * s24 * s25; // Leaf frustration
    E = E + -1.0 * s0 * s25;  // Center connection
    E = E + 0.5 * s25 * s26; // Leaf frustration
    E = E + -1.0 * s0 * s26;  // Center connection
    E = E + 0.5 * s26 * s27; // Leaf frustration
    E = E + -1.0 * s0 * s27;  // Center connection
    E = E + 0.5 * s27 * s28; // Leaf frustration
    E = E + -1.0 * s0 * s28;  // Center connection
