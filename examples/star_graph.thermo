    E = E + 0.5 * s45 * s46; // Leaf frustration
    E = E + -1.0 * s0 * s46;  // Center connection
    E = E + 0.5 * s46 * s47; // Leaf frustration
    E = E + -1.0 * s0 * s47;  // Center connection
    E = E + 0.5 * s47 * s48; // Leaf frustration
    E = E + -1.0 * s0 * s48;  // Center connection
    E = E + 0.5 * s48 * s49; // Leaf frustration
    E = E + -1.0 * s0 * s49;  // Center connection
    return E;
}

fn main() -> void {
    let res = thermal_anneal(star_model, 5.0, 0.98, 2000);
}
