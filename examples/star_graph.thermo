    E = E + 0.5 * s31 * s32; // Leaf frustration
    E = E + -1.0 * s0 * s32;  // Center connection
    E = E + 0.5 * s32 * s33; // Leaf frustration
    E = E + -1.0 * s0 * s33;  // Center connection
    E = E + 0.5 * s33 * s34; // Leaf frustration
    E = E + -1.0 * s0 * s34;  // Center connection
    E = E + 0.5 * s34 * s35; // Leaf frustration
    E = E + -1.0 * s0 * s35;  // Center connection
    E = E + 0.5 * s35 * s36; // Leaf frustration
    E = E + -1.0 * s0 * s36;  // Center connection
